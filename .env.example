# 站点信息
VITE_SITE_NAME = "汇聚之所" # 名称
VITE_SITE_AUTHOR = "jie.chen" # 作者
VITE_SITE_KEYWORDS = "nest,个人主页,汇聚之所" # 关键词
VITE_SITE_DES = "nest · 汇聚之所，个人项目的统一入口" # 站点简介
VITE_SITE_URL = "alvis.org.cn" # 站点地址
VITE_SITE_LOGO = "/images/brand/nest.svg" # SVG favicon
VITE_SITE_MAIN_LOGO = "/images/brand/nest.svg" # 无文字 SVG 标志
VITE_SITE_APPLE_LOGO = "/images/brand/nest-180.png" # 同一 SVG 导出的 Apple 图标

# 简介文本
VITE_DESC_HELLO = "nest · 汇聚之所"
VITE_DESC_TEXT = "个人项目、工具与灵感，在这里汇聚"
VITE_DESC_HELLO_OTHER = "Oops !"
VITE_DESC_TEXT_OTHER = "哎呀，这都被你发现了（ 再点击一次可关闭 ）"

# 社交链接
## 请在 src/assets/socialLinks.json 文件中配置

# 网站链接
## 请在 src/assets/siteLinks.json 文件中配置
## 保留原 icon 名称；也可将 image 或 icon 配置为 SVG / PNG 等图片路径

# 天气接口（公开地址，不包含 Key）
# 高德 Key 和备用服务地址仅在服务器 .env.weather 中配置
# 本地调试可临时改为 /api/weather?city=110101
VITE_WEATHER_API = "/api/weather"

# 建站日期
## 若不需要，请设为空即可
## 请按照 YYYY-MM-DD 格式填写或者仅填写年份 YYYY
VITE_SITE_START = "2026-11-04"

# ICP 备案号
## 若不需要，请设为空即可
VITE_SITE_ICP = "冀ICP备2024050565号-2"

# 歌曲 API 地址
## 请参照 https://github.com/xizeyoupan/Meting-API#deno-deploy 进行 API 服务部署
## 此处提供的服务可能会超量从而无法访问，请自行部署
## 若使用 QQ 音乐歌单，歌曲数量最好不要超出 50 首
## 备用：https://api.wuenci.com/meting/api/
VITE_SONG_API = "https://api-meting.alvis.org.cn/api"
# 歌曲服务器 ( netease-网易云, tencent-qq音乐 )
VITE_SONG_SERVER = "netease"
# 播放类型 ( song-歌曲, playlist-播放列表, album-专辑, search-搜索, artist-艺术家 )
VITE_SONG_TYPE = "playlist"
# 播放 ID ( 若无需播放器，请设为空即可 )
VITE_SONG_ID = "14060893770"
