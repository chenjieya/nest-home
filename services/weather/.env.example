# 只在服务器填写真实 Key；不要提交真实配置。
AMAP_KEY=
# 可选：用只读挂载文件替代环境变量，优先于 AMAP_KEY。
# AMAP_KEY_FILE=/run/secrets/amap_key

PORT=3001
DATA_DIR=/data
# 仅在受控反代后启用，Nginx 必须覆盖 X-Real-IP；端口只绑定本机或 Docker 内网。
TRUST_PROXY=true

FALLBACK_ENABLED=true
FALLBACK_WEATHER_URL=https://api.oioweb.cn/api/weather/GetWeather
UPSTREAM_TIMEOUT_MS=4000
CACHE_TTL_SECONDS=600
STALE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=1000
RATE_LIMIT_PER_MINUTE=20
GLOBAL_RATE_LIMIT_PER_MINUTE=120
# 高德定位和天气的请求尝试合并计数，0 表示禁止调用；只管本服务，不代表账号总额度。
AMAP_MONTHLY_LIMIT=4000
